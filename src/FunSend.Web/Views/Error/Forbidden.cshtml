@model string
@{
    ViewData["Title"] = "No access";
}

<section class="error-page">
    <p class="error-code">403</p>
    <h1>This is not yours to open</h1>
    <p class="muted">
        You are signed in, but this page belongs to another user or needs a
        different role.
    </p>
    <a class="button" asp-controller="Home" asp-action="Index">Back to the feed</a>
</section>
