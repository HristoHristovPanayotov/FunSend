@{
    ViewData["Title"] = "Something went wrong";
}

<section class="error-page">
    <p class="error-code">500</p>
    <h1>Something went wrong on our side</h1>
    <p class="muted">
        The error is written to the log. Please try again, and if it keeps
        happening, report it with the time it occurred.
    </p>
    <a class="button" asp-controller="Home" asp-action="Index">Back to the feed</a>
</section>
